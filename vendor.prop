#
# Only properties the build does NOT derive itself belong here.
#
# These are generated from BoardConfig variables and must not be repeated,
# otherwise post_process_props fails with "found duplicate sysprop assignments":
#   ro.bionic.arch / ro.bionic.cpu_variant        <- TARGET_CPU_VARIANT_RUNTIME
#   ro.bionic.2nd_arch / ro.bionic.2nd_cpu_variant <- TARGET_2ND_CPU_VARIANT_RUNTIME
#   dalvik.vm.isa.*.variant / .features           <- DEX2OAT_TARGET_CPU_VARIANT_RUNTIME
#   ro.hwui.use_vulkan                            <- TARGET_USES_VULKAN
#   ro.minui.pixel_format                         <- TARGET_RECOVERY_PIXEL_FORMAT
#   ro.board.platform                             <- TARGET_BOARD_PLATFORM
#   ro.zygote / dalvik.vm.dex2oat64.enabled       <- core_64_bit.mk
#   ro.recovery.usb.*                             <- build defaults (same values)
#
# Values follow the dump the blobs come from, and every Rockchip-specific
# property here was checked against the strings of the blob that reads it.
# Run BRINGUP-NOTES.md 7.18's one-liner before adding or keeping one.
#

## Bluetooth
ro.rk.bt_enable=true
persist.bt.power.down=true
persist.bluetooth.btsnoopsize=0xffff
persist.bluetooth.btsnooplogmode=disable
persist.bluetooth.showdeviceswithoutnames=false
vendor.bluetooth.enable_timeout_ms=11000

# Every profile service in packages/modules/Bluetooth is gated on a sysprop that
# defaults to *false* (Config.java -> <Profile>Service.isEnabled() ->
# BluetoothProperties.isProfileXEnabled().orElse(false)); only GATT defaults to
# true. Without these the stack pairs and bonds fine but connects nothing:
#   BluetoothHidHostService: getHidHostService(): service is null
#   CachedBluetoothDevice: No profiles. Maybe we will connect later
# which leaves a BT remote (HOGP, UUID 0x1812) bonded but dead, and TV Settings
# stuck on "Connecting...". Values follow the stock ROM's product/etc/build.prop.
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=false
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true

## Dalvik heap
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m
dalvik.vm.dex2oat-threads=4
dalvik.vm.boot-dex2oat-threads=4

## DRM
drm.service.enabled=true

## Ethernet
ro.rk.ethernet_settings=true

## Graphics
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.cpuvulkan.version=4202496
ro.surface_flinger.has_HDR_display=true
graphics.gpu.profiler.support=true
# All three are still read by the RKR8 hwcomposer.rk30board.so, and
# vendor.hwc.device.primary by hw_output.default.so as well.
vendor.hwc.compose_policy=1
vendor.hwc.device.primary=HDMI-A,TV
persist.vendor.framebuffer.main=1920x1080@60
# Deliberately NOT set: vendor.hwc.enable_dynamic_display_mode=1, which RKR8
# ships and its hwcomposer reads. It lets the composer switch display mode at
# runtime, which is a behaviour change on top of a fixed framebuffer.main and
# not something to introduce on the first boot of a blob rebase. Try it once
# the rest is known good.
#
# Dropped with the rebase: vendor.gralloc.disable_afbc, which no blob in either
# dump reads. AFBC control moved into the ro.vendor.arm.gralloc.* usage masks
# below.

## Arm DDK configuration
# Read by libGLES_mali.so and by nothing else. New in the g25p0 DDK -- the
# g15p0 build the M9S shipped has none of these strings, which is why the M9S
# ROM sets none of them. They are the EGL config table (which HAL formats are
# exposed, which can back a framebuffer, which are recordable) and the gralloc
# usage-bit masks for AFBC/AFRC. Verbatim from the Edge-2L build.prop: these
# describe the driver, not the board, so there is nothing to tune here.
ro.vendor.arm.egl.configs.nv12.hal_format=0x100
ro.vendor.arm.egl.configs.nv12.recordable=true
ro.vendor.arm.egl.configs.nv16.hal_format=0x10
ro.vendor.arm.egl.configs.nv16.recordable=true
ro.vendor.arm.egl.configs.nv21.hal_format=0x101
ro.vendor.arm.egl.configs.nv21.recordable=true
ro.vendor.arm.egl.configs.p010.hal_format=0x104
ro.vendor.arm.egl.configs.p010.recordable=true
ro.vendor.arm.egl.configs.p210.hal_format=0x105
ro.vendor.arm.egl.configs.p210.recordable=true
ro.vendor.arm.egl.configs.q410.hal_format=0x10a
ro.vendor.arm.egl.configs.q410.recordable=true
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.hal_format=0x2b
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.framebuffer_target=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.hal_format=0x16
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.recordable=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.hal_format=0x4
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.hal_format=0x3
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.hal_format=0x23
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.hal_format=0x1
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.recordable=true
ro.vendor.arm.egl.configs.y0l2.hal_format=0x103
ro.vendor.arm.egl.configs.y0l2.recordable=true
ro.vendor.arm.egl.configs.y210.hal_format=0x106
ro.vendor.arm.egl.configs.y210.recordable=true
ro.vendor.arm.egl.configs.y410.hal_format=0x107
ro.vendor.arm.egl.configs.y410.recordable=true
ro.vendor.arm.egl.configs.yuv420.hal_format=0x108
ro.vendor.arm.egl.configs.yuv420.recordable=true
ro.vendor.arm.egl.configs.yuyv.hal_format=0x102
ro.vendor.arm.egl.configs.yuyv.recordable=true
ro.vendor.arm.egl.configs.yvu420.hal_format=0x10e
ro.vendor.arm.egl.configs.yvu420.recordable=true
ro.vendor.arm.gralloc.afrc_chroma_usage_flags=0x100000000000000,0x80000000000000,0x180000000000000
ro.vendor.arm.gralloc.afrc_chroma_usage_mask=0x180000000000000
ro.vendor.arm.gralloc.afrc_luma_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_luma_usage_mask=0x70000000
ro.vendor.arm.gralloc.afrc_rgba_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_rgba_usage_mask=0x70000000
ro.vendor.arm.gralloc.force_back_buffer_usage_flags=0x40000000000000
ro.vendor.arm.gralloc.force_back_buffer_usage_mask=0x40000000000000
ro.vendor.arm.gralloc.no_afbc_usage_flags=0x20000000
ro.vendor.arm.gralloc.no_afbc_usage_mask=0x60000000
ro.vendor.arm.gralloc.shared_access_usage_flags=0x10000000
ro.vendor.arm.gralloc.shared_access_usage_mask=0x50000000

## HDMI
ro.rk.hdmi_enable=true
ro.vendor.hdmi_settings=true
ro.hdmi.device_type=4
persist.sys.hdmi.keep_awake=false

## Media
# The two debug.stagefright ones are read by AOSP's libstagefright, not by a
# blob. codec2_fbc_disable is still read by libcodec2_rk_component.so even
# though RKR8 stopped setting it in build.prop.
debug.stagefright.ccodec=4
debug.stagefright.c2inputsurface=-1
codec2_fbc_disable=0
# Dropped: rt_vdec_fbc_disable and rt_retriever_enable. They are rockit engine
# knobs, and neither dump ships librockit.so -- only the HIDL wrapper -- so no
# binary in either vendor image contains the strings. RKR8 replaced them with
# rt_player_mem_policy / rt_vdec_fbc_min_stride, which are equally unread here
# and are therefore not adopted.

## Platform
ro.soc.manufacturer=Rockchip
ro.vendor.rk_sdk=1
# The blob set, not the board -- it is the SDK the /vendor libraries were
# built from. MS is Rockchip's media / set-top-box line. BRINGUP-NOTES.md 7.25.
ro.vendor.sdkversion=RK3576_ANDROID14.0_MID_V1.0
ro.vendor.rksdk.version=ANDROID14_MS_RKR3
# Still dropped: ro.vendor.rkalgo=rkalgo. No file in this dump reads the name.

## Radio (no modem on this board)
ro.boot.noril=true
ril.function.dataonly=1
keyguard.no_require_sim=true

## Recovery
ro.minui.default_rotation=ROTATION_NONE
ro.minui.overscan_percent=2
ro.frp.pst=/dev/block/by-name/frp
ro.oem_unlock_supported=1

## Storage
ro.factory.storage_suppntfs=true
ro.vendor.udisk.visible=true
external_storage.casefold.enabled=1
external_storage.projid.enabled=1
external_storage.sdcardfs.enabled=0

## TEE
# New in RKR8 and load-bearing: libRkTeeKeymaster.so, libRkTeeGatekeeper.so and
# libRkTeeWeaver.so all read it, and none of the RKR5 libraries contained the
# string. It selects the secure-storage backend the TEE client asks for, which
# is the path that decides whether /data mounts at all (7.5-7.10), so it is set
# to the Edge-2L value rather than left to whatever the library defaults to.
ro.vendor.storage_type=0
# Kept, though no blob in either dump reads it -- it predates the rebase and
# costs nothing.
ro.tee.storage=rkss

## Wi-Fi
wifi.interface=wlan0
wifi.supplicant_scan_interval=15
persist.wifi.sleep.delay.ms=0
ro.wifi.sleep.power.down=true

## Misc
ro.vendor.frameratelock=true
