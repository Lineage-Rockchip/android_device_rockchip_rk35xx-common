<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.rockchip.settings">

    <uses-permission android:name="android.permission.HDMI_CEC"/>

    <application
        android:label="@string/rk_settings_title"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <!-- Injected into Settings > Display (DisplaySettings' tile category). -->
        <activity
            android:name=".RkSettingsActivity"
            android:exported="true"
            android:label="@string/rk_settings_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS"/>
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display"/>
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/rk_settings_title"/>
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/rk_settings_summary"/>
        </activity>

        <!-- Injected into Settings > Connected devices. -->
        <activity
            android:name=".CecSettingsActivity"
            android:exported="true"
            android:label="@string/cec_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS"/>
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect"/>
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/cec_title"/>
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/cec_summary"/>
        </activity>

        <!-- Injected into Developer options, right below the Debugging category. -->
        <activity
            android:name=".UsbSettingsActivity"
            android:exported="true"
            android:label="@string/usb_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS"/>
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.development"/>
            <meta-data
                android:name="com.android.settings.order"
                android:value="-1"/>
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/usb_title"/>
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/usb_summary"/>
        </activity>

        <!-- Next to the USB tile; enabled only on TARGET_SUPPORTS_DOCKER builds. -->
        <activity
            android:name=".DockerSettingsActivity"
            android:enabled="@bool/docker_supported"
            android:exported="true"
            android:label="@string/docker_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS"/>
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.development"/>
            <meta-data
                android:name="com.android.settings.order"
                android:value="-2"/>
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/docker_title"/>
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/docker_summary"/>
        </activity>

        <activity
            android:name=".ResolutionConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
    </application>
</manifest>
