#
# RK3588-only properties. Concatenated with ../vendor.prop into vendor/build.prop,
# so a property set in both is a duplicate and fails the build.
#

## Platform
ro.soc.model=RK3588

## Picture quality (AI-PQ)
# RK3576's librkswpq set without the VOP HWPQ ones, which RK3588 lacks.
# libmpp dlopens libsculptor (xpp), which runs librkswpq's SR/MEMC.
ro.vendor.aipq_settings=true
persist.vendor.rkpq.iptv_sr_enable=1
persist.vendor.rkpq.memc.strength=100
persist.vendor.rkpq.memc.watermark=0
persist.vendor.rkpq.mssr.initflag=26
persist.vendor.rkpq.sr.strength=100
persist.vendor.tvinput.rkpq.mode=3
