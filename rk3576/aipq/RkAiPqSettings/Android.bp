// AI PQ runtime settings for the MS-dump AI-PQ stack (librkswpq/libsculptor),
// exposed as a slice that TvSettings' two-panel SliceFragment renders natively
// in the right pane. The knob semantics are decoded from the NanoPi MS dump's
// TvSettings fork (its ai_lab/AiLabFragment), recorded in BRINGUP-NOTES.md 7.33.
//
// TvSliceLib ("TV Settings Slice Library") is the published partner-facing
// subset of TwoPanelSettingsLib: the PreferenceSliceBuilder facade, the
// TvSettingsSliceProvider base class and the compat core. Linking the whole
// TwoPanelSettingsLib instead packages its full transitive closure
// (SettingsLib, WifiTrackerLib, leanback, zxing...) -- 44 MB of dex for three
// classes of ours.
android_app {
    name: "RkAiPqSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "TvSliceLib",
        "rockchip-framework-client",
        // TvSliceLib defers style/attr resolution to the consuming app; its
        // resources parent from leanback-preference and Material3 styles.
        "androidx.leanback_leanback-preference",
        "com.google.android.material_material",
    ],
    // Tiny app; no benefit in shrinking and proguard has been known to break
    // slice action PendingIntents resolved by intent comparison.
    optimize: {
        enabled: false,
    },
    required: ["org.lineageos.rk3576.aipq.xml"],
}

prebuilt_etc {
    name: "org.lineageos.rk3576.aipq.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
    src: "org.lineageos.rk3576.aipq.xml",
    filename_from_src: true,
}

